# Copy to .env and fill in real values. Generate secrets e.g. with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Public base URL this deployment is reachable at — used to build the OIDC
# redirect_uri (must byte-exact-match what's registered at each configured
# IdP). No secret value, but has no safe default outside local dev; see
# apps/backend/src/config/public-url.ts and docs/adr/0004-oidc-authentication.md.
PUBLIC_URL=http://localhost:3000
