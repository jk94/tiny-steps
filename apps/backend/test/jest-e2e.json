{
  "moduleFileExtensions": ["js", "jsx", "json", "ts", "tsx"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@react-pdf/renderer$": "<rootDir>/../test-support/react-pdf-renderer.cjs"
  },
  "maxWorkers": 1
}
