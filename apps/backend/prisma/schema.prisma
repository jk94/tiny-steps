// Prisma schema — see https://pris.ly/d/prisma-schema
//
// NOTE on database provider switching (see also `config.example.yml` and the
// root README): `datasource.provider` below is a *static string*. Prisma 7
// no longer allows a connection URL in the schema file itself (it errors:
// "The datasource property `url` is no longer supported in schema files") —
// the URL is supplied instead:
//   - to the Prisma CLI (`generate`/`migrate`) via `prisma.config.ts`, which
//     reads it from the `DATABASE_URL` env var
//   - to the runtime `PrismaClient` via an explicit *driver adapter*
//     (`PrismaBetterSqlite3` for SQLite, see `src/prisma/prisma.service.ts`),
//     which also reads `DATABASE_URL`
// Switching providers (e.g. SQLite -> PostgreSQL) is therefore still a
// one-time, explicit change: edit this `provider` string, swap the driver
// adapter package/import in `PrismaService`, run `prisma generate`, and
// apply a fresh `prisma migrate deploy` — never a runtime toggle.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Display name shown in the UI. Nullable at the DB level so pre-existing
  // rows and OIDC logins without a `name` claim stay valid; the app forces
  // users through a blocking dialog to fill it in (see
  // `apps/frontend/src/components/MandatoryNameDialog.tsx`).
  name         String?
  // Nullable: OIDC-only users authenticate without a local password.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships          Membership[]
  events               Event[]
  growthMeasurements   GrowthMeasurement[]
  milestones           Milestone[]
  refreshTokens        RefreshToken[]
  createdInvites       Invite[]               @relation("InviteCreatedBy")
  acceptedInvites      Invite[]               @relation("InviteAcceptedBy")
  oidcIdentities       OidcIdentity[]
  pushSubscriptions    PushSubscription[]
  notificationSettings NotificationSettings[]
}

model OidcIdentity {
  id         String   @id @default(cuid())
  userId     String
  // Matches an `OidcProviderConfig.id` from `config.yml` (see
  // `src/config/oidc-provider.config.ts`) — config-defined, not a DB FK,
  // since providers aren't DB rows.
  providerId String
  // The OIDC `sub` claim from the provider.
  subject    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([providerId, subject])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships Membership[]
  children    Child[]
  invites     Invite[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  householdId String
  // Stores a `HouseholdRole` string value (Owner/Co-Parent/...; see PRD
  // section 3 and `src/household/household-role.enum.ts`). Kept as a plain
  // `String`, not a Prisma `enum`, because Prisma's `enum` type is not
  // supported on the SQLite connector — this is permanent, not a migration
  // stepping stone. Enforced at the application layer via
  // `toHouseholdRole()`; see ADR-0002.
  role        String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  household Household @relation(fields: [householdId], references: [id])

  @@unique([userId, householdId])
}

model Invite {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  householdId      String
  createdByUserId  String
  // HouseholdRole granted on acceptance; MVP always CO_PARENT, set server-side only.
  role             String
  expiresAt        DateTime
  revokedAt        DateTime?
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime  @default(now())

  household      Household @relation(fields: [householdId], references: [id])
  createdByUser  User      @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  acceptedByUser User?     @relation("InviteAcceptedBy", fields: [acceptedByUserId], references: [id])
}

model Child {
  id            String   @id @default(cuid())
  householdId   String
  name          String
  birthDate     DateTime
  // Path to the stored photo file, relative to `resolveUploadsDir()` (e.g.
  // "children/<childId>-<uuid>.jpg"), NOT an absolute host path and NEVER
  // returned to API clients directly — see `ChildPhotoStorageService` and
  // ADR-0003. Null when no photo has been uploaded.
  photoPath     String?
  photoMimeType String?
  // Optional biological sex ('FEMALE' | 'MALE'; see
  // `src/child/child-sex.enum.ts`). Null means "not specified", which is a
  // first-class state, not missing data: without it the app shows growth
  // values and trends but deliberately no WHO percentiles (W-10), rather than
  // guessing a default. This is the ONLY thing the field drives — nothing
  // else in the app branches on it. Plain `String`, not a Prisma `enum`, for
  // the same reason as `Membership.role`/`Event.type` (SQLite connector); read
  // exclusively through `toChildSex()`. See ADR-0002 and ADR-0006's
  // GrowthMeasurement addendum.
  sex           String?
  createdAt     DateTime @default(now())

  household            Household              @relation(fields: [householdId], references: [id])
  events               Event[]
  growthMeasurements   GrowthMeasurement[]
  milestones           Milestone[]
  notificationSettings NotificationSettings[]
}

/// A body-measurement record (weight / length or height / head circumference)
/// taken at an arbitrary point in time, typically after a pediatric check-up.
///
/// Deliberately a standalone table beside `Event` rather than a fourth event
/// type: it has its own `measuredAt` semantics, no timer duality, several
/// optional values per row, sex-specific derived percentiles, and it is not
/// part of the mixed daily activity timeline — see ADR-0006's addendum.
model GrowthMeasurement {
  id                           String   @id @default(cuid())
  childId                      String
  // The household member who recorded the measurement, mirroring
  // `Event.userId` (W-7).
  userId                       String
  measuredAt                   DateTime
  // All three values are individually optional (W-2), but at least one must be
  // present (W-1) — enforced at the application layer, since that is a
  // cross-column rule SQLite cannot express as a column constraint.
  // Stored as integers in fixed base units (W-3): grams and millimetres. No
  // floats, so a value can never drift through rounding.
  weightGrams                  Int?
  lengthMillimeters            Int?
  headCircumferenceMillimeters Int?
  // Manual override of the body-measure method (W-18): 'LYING' | 'STANDING'.
  // Null means "derive automatically from age at measurement time" (W-17) —
  // the normal case, not a missing value. Plain `String`, not a Prisma `enum`
  // (SQLite connector, ADR-0002); read via `toLengthMeasurementPosition()`.
  lengthMeasurementPosition    String?
  note                         String?
  createdAt                    DateTime @default(now())
  // Server-side write timestamp. Unlike `Event.updatedAt` this is NOT a
  // Last-Write-Wins tiebreak: growth tracking is an online-only feature with
  // no offline buffering (W-16), so ADR-0011 does not apply here. Kept for
  // traceability and the raw-data export.
  updatedAt                    DateTime @updatedAt

  // Cascade: a measurement is meaningless without its child, and deleting a
  // child profile must not be blocked by an FK constraint — same pattern as
  // the Event detail tables.
  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  // Deliberately no cascade: deleting a user must not silently erase the
  // measurements they recorded for a shared child, mirroring `Event.user`.
  user  User  @relation(fields: [userId], references: [id])

  // The only access pattern: a child's measurements in chronological order,
  // optionally windowed by `measuredAt`.
  @@index([childId, measuredAt])
}

/// A developmental milestone ("first smile", "first steps"), either picked
/// from the code-side template catalog or written freely by a parent.
///
/// Like `GrowthMeasurement` a standalone table beside `Event` rather than a
/// fourth event type (see ADR-0006's addendum): it is a remembrance record
/// read far more often than written, has no timer semantics, carries photos,
/// and is deliberately absent from the mixed daily activity timeline.
model Milestone {
  id          String   @id @default(cuid())
  childId     String
  // The household member who recorded the milestone, mirroring `Event.userId`
  // (M-14).
  userId      String
  // Key from the template catalog (e.g. "FIRST_SMILE"), or null for a free
  // entry (M-2/M-4). Drives both the uniqueness rule below and the "already
  // recorded" marker in the catalog view (M-5). Plain `String`, not a Prisma
  // `enum` (SQLite connector, ADR-0002); read via `toMilestoneTemplate()`.
  templateKey String?
  // ALWAYS set, for template and free entries alike. For a template entry this
  // is the translated catalog label as it read when the entry was created —
  // the frontend sends it, and it is then frozen. Deliberately a stored value
  // rather than a runtime translation of `templateKey`: a milestone is a
  // memory, and renaming a catalog template in a later release must not
  // retroactively reword what a parent recorded years earlier.
  title       String
  // 'MOTOR' | 'LANGUAGE' | 'SOCIAL' | 'PHYSICAL' (M-3). Derived server-side
  // from the catalog for template entries; an optional free choice for free
  // entries. Plain `String` for the same reason as `templateKey`; read via
  // `toMilestoneCategory()`.
  category    String?
  // A calendar day (`YYYY-MM-DD` parsed to UTC midnight), stored exactly like
  // `Child.birthDate` and `GrowthMeasurement.measuredAt` — a milestone happens
  // on a day, not at an instant.
  achievedAt  DateTime
  note        String?
  createdAt   DateTime @default(now())
  // Server-side write timestamp. Like `GrowthMeasurement.updatedAt` this is
  // NOT a Last-Write-Wins tiebreak — milestones are online-only with no
  // offline buffering (M-15), so ADR-0011 does not apply. Traceability and the
  // raw-data export only.
  updatedAt   DateTime @updatedAt

  // Cascade: a milestone is meaningless without its child, and deleting a
  // child profile must not be blocked by an FK constraint — same pattern as
  // `GrowthMeasurement`.
  child  Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  // Deliberately no cascade: deleting a user must not silently erase the
  // milestones they recorded for a shared child, mirroring `Event.user`.
  user   User             @relation(fields: [userId], references: [id])
  photos MilestonePhoto[]

  // Enforces M-5 (one entry per template per child) at the database level.
  // SQLite treats multiple NULLs as distinct, so free entries (`templateKey`
  // = null) are unaffected — that is intended, but it is connector-specific
  // behaviour and has to be re-checked when moving to PostgreSQL/MySQL.
  @@unique([childId, templateKey])
  // The only access pattern: a child's milestones in chronological order,
  // optionally windowed by `achievedAt`.
  @@index([childId, achievedAt])
}

/// One photo attached to a milestone (M-7/M-8). Reuses the local-disk storage
/// pattern from ADR-0003 rather than introducing object storage.
model MilestonePhoto {
  id          String   @id @default(cuid())
  milestoneId String
  // Path relative to `resolveUploadsDir()` (e.g.
  // "milestones/<milestoneId>-<uuid>.jpg"), NOT an absolute host path and
  // NEVER returned to API clients — see `MilestonePhotoStorageService` and
  // ADR-0003.
  path        String
  mimeType    String
  // Stable render order within one milestone's gallery (M-10), assigned on
  // upload as "current maximum + 1" so the gallery cannot reshuffle between
  // loads.
  sortIndex   Int
  createdAt   DateTime @default(now())

  // Cascade: deleting a milestone drops its photo rows in one step; the files
  // themselves are removed best-effort afterwards by `MilestoneService`
  // (M-9).
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, sortIndex])
}

model Event {
  id         String   @id @default(cuid())
  childId    String
  userId     String
  // Placeholder string for now (Feeding/Sleep/Diaper/...); see PRD 4.1/5.2.
  type       String
  occurredAt DateTime
  // Timer semantics, hoisted to the base Event (not just FeedingDetail)
  // because they're shared across future timer-based event types (Sleep
  // will be timer-based too). `startedAt` is set for timer-based events,
  // null for point events (bottle, solid, future diaper). `endedAt` is null
  // while a timer-based event is running, or always null for point events.
  // `occurredAt` stays the single canonical non-null column used for
  // sorting a mixed-type timeline, deliberately duplicating `startedAt` for
  // timer events at creation time.
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime @default(now())
  // Server-side write timestamp, bumped by Prisma on every `event.update()`
  // (including nested detail-only edits). Used as the Last-Write-Wins tiebreak
  // for offline-buffered edits/timer-stops: a buffered write carrying a
  // `clientTimestamp` older than this is rejected as a conflict — see
  // ADR-0011 and the per-type services' `update()`/`stop()`.
  updatedAt  DateTime @updatedAt

  child         Child          @relation(fields: [childId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  feedingDetail FeedingDetail?
  diaperDetail  DiaperDetail?
}

model FeedingDetail {
  eventId String @id
  // FeedingType enum value (BREAST | BOTTLE | SOLID); see
  // `src/feeding/feeding-type.enum.ts`. Kept as a plain `String`, not a
  // Prisma `enum`, for the same reason as `Membership.role` — Prisma's
  // `enum` type isn't supported on the SQLite connector. See
  // `docs/adr/0002-application-level-household-roles-and-invites.md`.
  feedingType String
  // FeedingSide enum value (LEFT | RIGHT); only set when feedingType is
  // BREAST.
  side        String?
  // Only set when feedingType is BOTTLE.
  amountMl    Int?
  // Free text, optional for all feeding types.
  note        String?

  // Cascade: deleting an Event auto-removes its FeedingDetail, no manual
  // two-step delete needed in FeedingService.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model DiaperDetail {
  eventId String @id
  // DiaperType enum value (PEE | STOOL | BOTH); see
  // `src/diaper/diaper-type.enum.ts`. Plain `String`, not a Prisma `enum`,
  // same reason as `FeedingDetail.feedingType` — see ADR-0002.
  diaperType String
  // Optional consistency note; free text, meaningful for every diaperType
  // (unlike FeedingDetail's side/amountMl, there is no diaperType this
  // field is irrelevant for).
  note       String?

  // Cascade: deleting an Event auto-removes its DiaperDetail, same pattern
  // as FeedingDetail — no manual two-step delete in DiaperService.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  // The device/app FCM registration token — unique so re-registering the same
  // device upserts rather than duplicating (see PushService.upsert).
  token  String @unique
  // PushPlatform value ('ANDROID' | 'IOS'); see
  // `src/push/push-platform.enum.ts`. Plain `String`, not a Prisma `enum`,
  // for the same reason as `Event.type`/`Membership.role` — Prisma's `enum`
  // type isn't supported on the SQLite connector. Guarded at the application
  // layer via `toPushPlatform()`, mirroring `toEventType()`. See ADR-0002.
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model NotificationSettings {
  id                            String    @id @default(cuid())
  userId                        String
  childId                       String
  feedingReminderEnabled        Boolean   @default(true)
  feedingReminderThresholdHours Int       @default(4)
  // Last time a feeding reminder was actually sent for this (user, child) —
  // used together with the last feeding event's timestamp to de-duplicate
  // reminders (see NotificationSchedulerService.checkFeedingReminders).
  feedingReminderLastSentAt     DateTime?
  dailySummaryEnabled           Boolean   @default(true)
  // Hour-of-day (0–23) at which the daily summary is sent, interpreted in the
  // SERVER's local timezone — an MVP simplification (no per-user timezone
  // handling yet), matching how the scheduler compares against the current
  // server hour.
  dailySummaryHourLocal         Int       @default(20)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  child Child @relation(fields: [childId], references: [id])

  // One settings row per (user, child) pair.
  @@unique([userId, childId])
}
