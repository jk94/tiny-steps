{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* The shared growth chart is consumed as TypeScript source, not as its
       built `dist/` output (which only the backend uses): Vite compiles it
       directly, so editing the chart hot-reloads instead of requiring a
       package rebuild first. The matching runtime resolution lives in
       `vite.config.ts` / `vitest.config.ts`. */
    "paths": {
      "@baby-tracker/growth-chart-static": ["../../packages/growth-chart-static/src/index.ts"],
      "@baby-tracker/growth-chart-static/geometry": [
        "../../packages/growth-chart-static/src/growthChartGeometry.ts"
      ],
      "@baby-tracker/growth-chart-static/server": [
        "../../packages/growth-chart-static/src/server.ts"
      ]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "../../packages/growth-chart-static/src"]
}
